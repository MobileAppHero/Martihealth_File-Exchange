# --- SFTP / S3 (existing MartiSftp-dev stack) ---
AWS_REGION=us-east-1
LANDING_BUCKET=marti-sftp-landing-dev-453195924022
SFTP_SERVER_ID=s-2e5a9b10a47b43f98
SFTP_USER_ROLE_ARN=arn:aws:iam::453195924022:role/marti-sftp-user-dev

